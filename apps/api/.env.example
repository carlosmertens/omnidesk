# Loaded by Nest's ConfigModule (validated in src/config/env.validation.ts)
# and by prisma.config.ts (`import 'dotenv/config'`) for the Prisma CLI + seed.

# Required. Must match the Postgres credentials in the root .env / docker-compose.yml.
DATABASE_URL="postgresql://omnidesk:omnidesk_dev_password@localhost:5432/omnidesk_dev?schema=public"

# Required. Signs the session cookie — use a long random value outside local dev.
SESSION_SECRET="dev-only-change-me"

# Optional (defaults shown).
# PORT=3000
# FRONTEND_URL="http://localhost:5173"

# Used only by `prisma db seed` (prisma/seed.ts) to create/update the first
# ADMIN user — log in to the web app with these. Password: min 8 chars.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="SeedPass#1234"
