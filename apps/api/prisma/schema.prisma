// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  ASSOCIATE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  role         UserRole
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Schema required by connect-pg-simple (apps/api/src/auth/) — column names/types
// and the expire index are fixed by that library, not a modeling choice.
model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}
